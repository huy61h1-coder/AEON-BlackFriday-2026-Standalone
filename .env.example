ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
# Without a persistent data directory, copy the current public catalog and
# storefront settings from the running site before a new release starts.
AEON_BOOTSTRAP_PUBLIC_URL=https://blackfriday.tinhgon.xyz/api/state
# Local/offline preview only; never enable for Vibe Host deployment.
AEON_ALLOW_SAMPLE_DATA=false
# Catalog stays in the running release; Supabase below can be used only for Outlook.
AEON_STATE_STORAGE=local
GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Absolute path to a persistent volume outside the application release directory.
# Preserves products, settings, uploaded images, quote files, and file-based Outlook tokens.
AEON_DATA_DIR=
# Use saved UI/layout values; the committed shell only supplies missing defaults.
AEON_LOCK_STOREFRONT=true
# Optional: Microsoft Graph delegated Outlook mail integration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://blackfriday.tinhgon.xyz/api/admin/outlook/callback
AEON_OUTLOOK_TOKEN_KEY=
# supabase keeps the encrypted Outlook connection across deploys; file is for a persistent local disk.
AEON_OUTLOOK_STORAGE=supabase
