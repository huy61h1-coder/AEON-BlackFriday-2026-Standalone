ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Replace only outdated UI/layout state with the committed shell; current admin saves stay editable.
AEON_LOCK_STOREFRONT=true
# Optional: Microsoft Graph delegated Outlook mail integration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://blackfriday.tinhgon.xyz/api/admin/outlook/callback
AEON_OUTLOOK_TOKEN_KEY=
# supabase keeps the encrypted Outlook connection across deploys; file is for a persistent local disk.
AEON_OUTLOOK_STORAGE=supabase
